{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --offline",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --watchAll=false",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.3.0",
    "@expo/metro-runtime": "~6.1.2",
    "@hookform/resolvers": "^3.9.0",
    "@livekit/react-native": "^2.4.0",
    "@livekit/react-native-webrtc": "^125.0.7",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-community/slider": "^5.0.1",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~54.0.35",
    "expo-auth-session": "~7.0.11",
    "expo-av": "^16.0.8",
    "expo-constants": "^18.0.13",
    "expo-device": "^8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "^0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.53.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.17",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@livekit/react-native-webrtc",
          "react-native-background-timer"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.pnpm/(react-native|@react-native|expo|@expo|nativewind|zustand)[^/]*/node_modules/|(jest-)?react-native|@react-native|expo(nent)?|@expo(nent)?|nativewind|zustand))"
    ]
  }
}
